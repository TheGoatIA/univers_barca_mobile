{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "arrowParens": "always",
  "overrides": [
    { "files": "*.md", "options": { "proseWrap": "preserve", "printWidth": 120 } },
    { "files": ["*.yml", "*.yaml"], "options": { "singleQuote": false } }
  ]
}
